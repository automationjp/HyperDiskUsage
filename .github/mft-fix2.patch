+// WOF's filter can hide the underlying reparse flag from ordinary metadata.
+// Verify the provider through the documented WofIsExternalFile API instead.
+fn assert_wof(path: &Path) {
+    #[link(name = "Wofutil")]
+    extern "system" {
+        fn WofIsExternalFile(
+            path: *const u16,
+            external: *mut i32,
+            provider: *mut u32,
+            info: *mut std::ffi::c_void,
+            length: *mut u32,
+        ) -> i32;
+    }
+    let wide: Vec<u16> = path.as_os_str().encode_wide().chain(Some(0)).collect();
+    let (mut external, mut provider) = (0i32, 0u32);
+    // SAFETY: terminated path and correctly sized live output values; optional
+    // provider-specific info and its length are both omitted.
+    let hr = unsafe {
+        WofIsExternalFile(wide.as_ptr(), &mut external, &mut provider,
+                          std::ptr::null_mut(), std::ptr::null_mut())
+    };
+    assert!(hr >= 0, "WofIsExternalFile failed: {hr:#x}");
+    assert_ne!(external, 0, "fixture was not WOF compressed");
+    assert_eq!(provider, 2, "fixture must use WOF_PROVIDER_FILE");
+}
