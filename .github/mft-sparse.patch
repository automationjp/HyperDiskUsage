+    #[test]
+    fn issue41_continuation_unit_zero_does_not_override_first_extent_accounting() {
+        // Real NTFS: sparse first extent has CompressionUnit=4, continuations
+        // carry zero there. The first extent's 0x40 field is the stream total.
+        let (mut base, ext) = data_extension_fixture(true);
+        let header = parse_record_header(&base).unwrap();
+        let data = Attributes::new(&base, &header)
+            .find(|a| a.type_code == attr_type::DATA).unwrap();
+        base[data.pos + 34..data.pos + 36].copy_from_slice(&4u16.to_le_bytes());
+        base[data.pos + 64..data.pos + 72].copy_from_slice(&12288u64.to_le_bytes());
+        let mut reader = MftReader::open(volume(with_metadata_records(vec![base, ext], 5))).unwrap();
+        let entry = reader.entry(16).expect("valid sparse continuation");
+        assert_eq!((entry.sizes.real_size, entry.sizes.allocated_size), (16384, 12288));
+        assert!(reader.is_complete());
+    }
+
+    #[test]
+    fn issue41_sparse_run_accounting_is_selected_by_the_first_extent_only() {
+        // A continuation's CompressionUnit is not a new whole-stream header.
+        let (base, mut ext) = data_extension_fixture(true);
+        ext[98..100].copy_from_slice(&4u16.to_le_bytes());
+        let mut reader = MftReader::open(volume(with_metadata_records(vec![base, ext], 5))).unwrap();
+        let entry = reader.entry(16).expect("valid sparse continuation");
+        assert_eq!(entry.sizes.allocated_size, 3 * CLUSTER as u64);
+        assert!(reader.is_complete());
+    }
