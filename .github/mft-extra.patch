+    #[test]
+    fn resident_allocation_includes_alignment_and_retained_capacity() {
+        for length in [0usize, 1, 7, 8, 9, 100, 123, 256] {
+            let mut rec = record_header_bytes(FLAG_IN_USE, 56, 1024, 1);
+            let end = push_resident(&mut rec, 56, attr_type::DATA, &vec![1; length]);
+            end_marker(&mut rec, end);
+            let header = parse_record_header(&rec).unwrap();
+            let attr = Attributes::new(&rec, &header).next().unwrap();
+            let sizes = parse_data_sizes(&rec, &attr, 4096).unwrap();
+            assert_eq!(sizes.real_size, length as u64);
