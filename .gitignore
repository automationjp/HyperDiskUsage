# Rust & Cargo
target/
**/target/
Cargo.lock.bak

# Build artifacts
dist/
.build/

# Tooling / editors
.idea/
.vscode/
.cursorindexingignore
.DS_Store
Thumbs.db
*.swp
*~

# Merge and patch leftovers. `.orig` in particular is easy to commit by
# accident, and it is a copy of a source file under a name nobody reviews.
*.orig
*.rej

# Local secrets. Nothing here reads a .env today; the entry is here so that a
# later one cannot be committed by accident.
.env
.env.local

# Coverage output
*.profraw
lcov.info
coverage/

# Agent working state. These hold scratch worktrees and session data for
# whoever is driving the repo, not anything the project ships. `.claude` in
# particular accumulates full worktree copies.
.agents/
.claude/
.codex/

# Cargo timings / rustc artifacts
**/cargo-timings/
**/*.profdata
**/*.profraw
.flatpak-builder/

# Investigation leftovers and editor state. Ignored rather than deleted: the C
# benchmarks and the btrfs probe still have content, and only their author knows
# whether they are finished with them.
.btrfs-probe/
project_memory/
.specstory/

# Python benchmark bytecode
__pycache__/
*.pyc
